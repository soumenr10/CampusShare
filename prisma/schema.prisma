// CampusShare — Campus Peer-to-Peer Marketplace
// Prisma Schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum ContactPreference {
  EMAIL
  PHONE
  CHAT
}

enum Role {
  STUDENT
  ADMIN
}

enum Category {
  TEXTBOOKS
  ELECTRONICS
  DORM_ESSENTIALS
  FREE_DONATIONS
  NOTES_GUIDES
  ENGINEERING_SUPPLIES
}

enum ItemCondition {
  BRAND_NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum VoteType {
  UP
  DOWN
}

enum MessageType {
  TEXT
  OFFER
  RESERVE
  SOLD
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// ─── Models ─────────────────────────────────────────────────────────────────────

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  name              String
  collegeName        String
  department        String
  graduationYear    Int?
  hostel            String?
  avatarUrl         String?
  bio               String?
  contactPreference ContactPreference @default(EMAIL)
  phone             String?
  rating            Float             @default(0)
  reviewCount       Int               @default(0)
  isVerified        Boolean           @default(false)
  role              Role              @default(STUDENT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items              Item[]
  notes              Note[]
  reviewsGiven       Review[]                  @relation("ReviewerRelation")
  reviewsReceived    Review[]                  @relation("SellerRelation")
  messagesSent       Message[]
  conversations      ConversationParticipant[]
  noteVotes          NoteVote[]
  reportsSubmitted   Report[]                  @relation("ReporterRelation")
  reportsReceived    Report[]                  @relation("ReportedUserRelation")

  @@map("users")
}

model Item {
  id          String        @id @default(cuid())
  title       String
  description String
  category    Category
  price       Float         @default(0)
  condition   ItemCondition
  images      String[]
  status      ItemStatus    @default(AVAILABLE)
  campusZone  String?
  sellerId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller  User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviews Review[]
  reports Report[]

  @@index([category])
  @@index([status])
  @@index([sellerId])
  @@map("items")
}

model Note {
  id           String   @id @default(cuid())
  title        String
  description  String
  department   String?
  fileUrl      String
  thumbnailUrl String?
  uploaderId   String
  upvotes      Int      @default(0)
  downvotes    Int      @default(0)
  createdAt    DateTime @default(now())

  uploader User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  votes    NoteVote[]
  reports  Report[]

  @@index([uploaderId])
  @@map("notes")
}

model NoteVote {
  id       String   @id @default(cuid())
  noteId   String
  userId   String
  voteType VoteType

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@map("note_votes")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  messageType    MessageType @default(TEXT)
  isRead         Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  sellerId   String
  itemId     String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  reviewer User @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)
  seller   User @relation("SellerRelation", fields: [sellerId], references: [id], onDelete: Cascade)
  item     Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, itemId])
  @@map("reviews")
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  itemId      String?
  noteId      String?
  userId      String?
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  reporter     User  @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
  item         Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  note         Note? @relation(fields: [noteId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportedUserRelation", fields: [userId], references: [id], onDelete: SetNull)

  @@map("reports")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@map("verification_tokens")
}
